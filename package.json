{
  "name": "fleetflow",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Logistics & Fleet Management Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:gateway",
    "dev:gateway": "npm run dev --workspace=@fleetflow/api-gateway",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "fleet-management",
    "logistics",
    "microservices",
    "nextjs",
    "typescript"
  ],
  "author": "Muhammad Bilal",
  "license": "MIT"
}
