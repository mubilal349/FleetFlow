{
  "name": "fleetflow",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Logistics & Fleet Management Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:gateway",
    "dev:gateway": "npm run dev --workspace=@fleetflow/api-gateway",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "fleet-management",
    "logistics",
    "microservices",
    "nextjs",
    "typescript"
  ],
  "author": "Muhammad Bilal",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
